POSTGRES_DB=gamevault
POSTGRES_USER=gamevault
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

GAMEVAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
GAMEVAULT_ADMIN_SESSION_MINUTES=60
GAMEVAULT_SELECTION_NAME=Spieleauswahl Freund
GAMEVAULT_COOKIE_SECURE=false

# GameTDB persistent Wii U XML catalog (full offline resolver cache)
GAMETDB_WIIU_URL=https://www.gametdb.com/wiiutdb.zip?LANG=DE
GAMETDB_CACHE_DIR=/data/provider-cache/gametdb

# Full persistent Nintendo GameTDB XML catalogs
GAMETDB_WII_URL_FULL=https://www.gametdb.com/wiitdb.zip?LANG=DE&WIIWARE=1&GAMECUBE=1
GAMETDB_3DS_URL=https://www.gametdb.com/3dstdb.zip?LANG=DE
GAMETDB_SWITCH_URL=https://www.gametdb.com/switchtdb.zip?LANG=DE
